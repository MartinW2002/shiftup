<% content_for :title, "My shifts · ShiftUp" %>

<div class="section-header">
  <h1>My shifts</h1>
  <%= link_to "Find shifts", shifts_path, class: "button button-secondary" %>
</div>

<% if @upcoming.any? %>
  <ul class="card-list">
    <% @upcoming.each do |signup| %>
      <% shift = signup.shift %>
      <li class="card card-row">
        <div>
          <%= link_to shift.activity.title, shift, class: "shift-time" %>
          <%= signup_status_badge(signup) %>
          <p><%= shift.time_range_text %></p>
          <p class="muted"><%= shift.activity.organization.name %><% if shift.activity.location.present? %> · <%= shift.activity.location %><% end %></p>
        </div>
        <%= render "shifts/signup_action", shift: shift, signup: signup %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="card">
    <p class="muted">You have no upcoming shifts.</p>
    <div class="actions"><%= link_to "Find a shift", shifts_path, class: "button" %></div>
  </div>
<% end %>

<% if @past.any? %>
  <h2>Past shifts</h2>
  <ul class="card-list" id="past-shifts">
    <% @past.each do |signup| %>
      <% shift = signup.shift %>
      <li class="card card-row">
        <div>
          <%= link_to shift.activity.title, shift, class: "shift-time" %>
          <p><%= shift.time_range_text %></p>
          <p class="muted"><%= shift.activity.organization.name %></p>
        </div>
        <%= attendance_badge(signup) %>
      </li>
    <% end %>
  </ul>
<% end %>
