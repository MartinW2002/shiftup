<% activity = @shift.activity %>
<% content_for :title, "#{activity.title} shift · ShiftUp" %>

<p class="breadcrumb"><%= link_to activity.organization.name, activity.organization %> <span class="breadcrumb-separator">/</span> <%= link_to activity.title, activity %></p>
<h1><%= activity.title %></h1>
<p class="lead"><%= @shift.time_range_text %></p>
<% if activity.location.present? %>
  <p class="muted"><%= activity.location %></p>
<% end %>

<div class="card card-row">
  <p>
    <%= places_text(@shift) %>
    <% if @my_signup %>
      <%= signup_status_badge(@my_signup) %>
      <%= attendance_badge(@my_signup) if @shift.started? && @my_signup.confirmed? %>
    <% end %>
  </p>
  <%= render "shifts/signup_action", shift: @shift, signup: @my_signup %>
</div>

<% if policy(@shift).update? %>
  <div class="actions">
    <%= link_to "Edit shift", edit_shift_path(@shift), class: "button button-secondary" %>
    <%= button_to "Delete shift", @shift, method: :delete, class: "button-danger",
                  form: { data: { turbo_confirm: "Delete this shift?" } } %>
  </div>

  <div class="section-header">
    <h2>Confirmed (<%= @confirmed.size %> of <%= @shift.capacity %>)</h2>
    <% if @shift.started? && @confirmed.any? %>
      <span class="muted"><%= attendance_summary(@confirmed) %></span>
    <% end %>
  </div>
  <div class="card">
    <% if @confirmed.any? %>
      <ul class="roster" id="confirmed-volunteers">
        <% @confirmed.each do |signup| %>
          <li>
            <span><%= signup.user.name %></span>
            <span class="muted"><%= signup.user.email %></span>
            <% if @shift.started? %>
              <%= attendance_badge(signup) %>
              <span class="segmented" role="group" aria-label="Attendance for <%= signup.user.name %>">
                <% { "present" => "Present", "absent" => "Absent" }.each do |value, label| %>
                  <%= button_to label, signup_attendance_path(signup), method: :patch,
                                params: { attendance: signup.attendance == value ? "unmarked" : value },
                                class: [ "button-secondary", "button-small", ("selected" if signup.attendance == value) ],
                                title: signup.attendance == value ? "Clear" : "Mark #{label.downcase}",
                                aria: { pressed: signup.attendance == value } %>
                <% end %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted">Nobody has signed up yet.</p>
    <% end %>
  </div>
  <% unless @shift.started? %>
    <p class="muted">Attendance can be recorded once the shift starts.</p>
  <% end %>

  <h2>Waiting list (<%= @waitlist.size %>)</h2>
  <div class="card">
    <% if @waitlist.any? %>
      <ol class="roster" id="waiting-list">
        <% @waitlist.each_with_index do |signup, index| %>
          <li><span class="roster-number"><%= index + 1 %></span><span><%= signup.user.name %></span> <span class="muted">joined <%= l(signup.created_at, format: :shift) %></span></li>
        <% end %>
      </ol>
    <% else %>
      <p class="muted">Nobody is waiting.</p>
    <% end %>
  </div>
<% end %>
