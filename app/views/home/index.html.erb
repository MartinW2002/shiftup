<% content_for :title, "ShiftUp" %>

<section class="hero">
  <h1>ShiftUp</h1>
  <p class="lead">Volunteer coordination for student organizations: publish shifts, sign up within capacity, and refill cancellations from a fair waiting list.</p>
  <% unless user_signed_in? %>
    <div class="actions">
      <%= link_to "Create an account", new_user_registration_path, class: "button" %>
      <%= link_to "Log in", new_user_session_path, class: "button button-secondary" %>
    </div>
  <% end %>
</section>

<% if user_signed_in? %>
  <h2>Your organizations</h2>
  <% if @memberships.any? %>
    <ul class="card-list">
      <% @memberships.each do |membership| %>
        <li>
          <%= link_to membership.organization, class: "card card-link" do %>
            <strong><%= membership.organization.name %></strong>
            <span class="badge"><%= membership.role.humanize %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="card">
      <p class="muted">You are not a member of any organization yet.</p>
      <div class="actions"><%= link_to "Browse organizations", organizations_path, class: "button" %></div>
    </div>
  <% end %>
<% end %>
